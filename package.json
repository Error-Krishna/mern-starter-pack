{
  "name": "mern-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mern/api --filter @mern/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @mern/api start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r --if-present clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
